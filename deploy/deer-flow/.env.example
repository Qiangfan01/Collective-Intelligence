# DeerFlow 环境变量模板
# 复制为 .env 后填写实际值。.env 不入库。

# ── 服务端口 ─────────────────────────────────────────────
# 只绑本机回环，不对局域网开放
PORT=2026

# ── 飞书应用 ─────────────────────────────────────────────
# 开放平台 → 应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 模型 ─────────────────────────────────────────────────
# 任选一个 OpenAI 兼容端点。以火山方舟为例：
VOLCENGINE_API_KEY=
# 或
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ── 运行时路径（docker compose 用）─────────────────────────
DEER_FLOW_CONFIG_PATH=./config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=./extensions_config.json
DEER_FLOW_HOME=./state

# ── 审计与审批 ───────────────────────────────────────────
# 审批卡的 HMAC 密钥，随便生成一个长随机串
OPS_APPROVAL_SECRET=
# 你的飞书 open_id，只有这个人能点批准按钮
OPS_OPERATOR_OPEN_ID=

# ── 时区 ─────────────────────────────────────────────────
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
