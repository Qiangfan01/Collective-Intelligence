{
  "middlewares": [],
  "mcpServers": {
    "elnops": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "eln_ops_mcp.server"],
      "cwd": "/app/ops-bot-eln",
      "env": {
        "ELN_OPS_CONFIG": "/app/ops-bot-eln/config.yaml",
        "OPS_APPROVAL_SECRET": "$OPS_APPROVAL_SECRET",
        "OPS_OPERATOR_OPEN_ID": "$OPS_OPERATOR_OPEN_ID",
        "FEISHU_APP_ID": "$FEISHU_APP_ID",
        "FEISHU_APP_SECRET": "$FEISHU_APP_SECRET"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 180,
      "description": "ELN 运维工具：只读巡检 + 需审批的修复动作"
    }
  },
  "skills": {}
}
